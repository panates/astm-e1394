  "keywords": [
    "astm",
    "astm-e1394",
    "e1394",
    "lis2-a2",
    "lis",
    "lims",
    "laboratory",
    "clinical-laboratory",
    "analyzer",
    "instrument",
    "medical-device",
    "e1381",
    "lis1-a",
    "parser",
    "serializer",
    "protocol"
  ],
  "version": "1.0.0-beta.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panates/astm-e1394.git",
    "directory": "packages/core/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@astm-e1394/dictionary": "workspace:^",
    "iconv-lite": "^0.7.3"
  },
  "devDependencies": {
    "@sinonjs/fake-timers": "^15.5.0",
    "expect": "^30.5.2"
  }
}
